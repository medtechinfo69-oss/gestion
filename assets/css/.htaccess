# =====================================================================
# Gestion des Dossiers — assets/css/
# =====================================================================
# Feuilles de style uniquement. Aucun script, aucun autre type de
# fichier n'est servi depuis ce dossier (voir aussi assets/.htaccess).

Options -Indexes -MultiViews

# Aucune execution de script.
<FilesMatch "\.(php|phar|phtml|php[0-9]|pht|shtml|pl|py|rb|cgi|sh|bash|bat|cmd|exe|asp|aspx|jsp|jspx)$">
    Require all denied
</FilesMatch>

# Seules les extensions .css et .map sont autorisees.
<FilesMatch "^(?!.*\.(css|map)$).+$">
    Require all denied
</FilesMatch>
